# Copy to .env and adjust. Every variable is optional; the defaults run fully offline.

# Providers
# llm_provider: extractive | openai | anthropic
EMRAG_LLM_PROVIDER=extractive
# embedding_provider: hashing | openai
EMRAG_EMBEDDING_PROVIDER=hashing
# vector_store: memory | qdrant
EMRAG_VECTOR_STORE=memory

# OpenAI (llm_provider=openai or embedding_provider=openai)
# OPENAI_API_KEY is also accepted.
EMRAG_OPENAI_API_KEY=
EMRAG_OPENAI_BASE_URL=https://api.openai.com/v1
EMRAG_OPENAI_CHAT_MODEL=gpt-4o-mini
EMRAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMRAG_OPENAI_EMBEDDING_DIM=1536

# Anthropic (llm_provider=anthropic)
# ANTHROPIC_API_KEY is also accepted.
EMRAG_ANTHROPIC_API_KEY=
EMRAG_ANTHROPIC_MODEL=claude-sonnet-5
EMRAG_ANTHROPIC_MAX_TOKENS=1024

# Qdrant (vector_store=qdrant)
EMRAG_QDRANT_URL=http://localhost:6333
EMRAG_QDRANT_API_KEY=
EMRAG_QDRANT_COLLECTION=emrag_chunks

# Storage
EMRAG_DATA_DIR=.emrag

# Ingestion
EMRAG_CHUNK_MAX_CHARS=900
EMRAG_CHUNK_OVERLAP_CHARS=150
EMRAG_MAX_FILE_BYTES=5000000

# Retrieval and validation
EMRAG_RETRIEVAL_TOP_K=12
EMRAG_RERANK_TOP_N=5
EMRAG_MIN_QUERY_COVERAGE=0.2
EMRAG_MAX_SUB_QUERIES=4
EMRAG_MIN_CLAIM_SUPPORT=0.6
EMRAG_MIN_GROUNDING_SCORE=0.8
EMRAG_MAX_ATTEMPTS=2

# Security
EMRAG_MAX_QUERY_CHARS=2000
EMRAG_REJECT_INJECTION_QUERIES=true

# Networking
EMRAG_HTTP_TIMEOUT_SECONDS=30
EMRAG_RETRY_ATTEMPTS=3
EMRAG_RETRY_MIN_WAIT=0.5
EMRAG_RETRY_MAX_WAIT=8

# Logging
EMRAG_LOG_LEVEL=INFO
EMRAG_LOG_JSON=true
